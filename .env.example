# Environment variables for Pocket Expense Splitter

# Database
# For local development with SQLite (default):
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (Supabase/Neon):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pocket_db?schema=public"

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email (Gmail SMTP) — use a Gmail App Password (not your real password)
# Enable at: https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-gmail-app-password"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pocket"
