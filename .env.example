# Environment variables for Pocket Expense Splitter
# Copy this file to .env and fill in the values

# ─── Database ─────────────────────────────────────────────────────────────────
# Local development (SQLite):
# DATABASE_URL="file:./prisma/dev.db"
# DIRECT_URL="file:./prisma/dev.db"

# Production (Supabase PostgreSQL):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):  https://your-app.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── FastAPI backend URL ──────────────────────────────────────────────────────
# Local: http://localhost:8000
# Production: https://your-backend.railway.app (or Render/Fly.io)
FASTAPI_URL="http://localhost:8000"

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your real password
# Enable at: https://support.google.com/accounts/answer/185833
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pocket"
